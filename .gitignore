# Generated per-radio codeplugs — regenerated by `just build`/`just flash`
build/

# Per-operator personalized copies of base.yaml (radio ID/name swapped in
# for a specific callsign) — base.yaml itself is the shared template that
# gets committed; these exported instances stay local and go stale fast.
base-*.yaml

# Dated manual backups (see just-before-risky-change convention)
backups/

# Stock/factory reference codeplug — personal reference, not part of the template
Powerwerk D168 Factory.yaml

# Local Claude Code tool permissions — machine-specific, not project config
.claude/

# macOS / editor cruft
.DS_Store
*.swp
